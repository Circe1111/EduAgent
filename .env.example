# =============================================================================
# EduAgent 2.0 - 环境变量配置模板
# 复制为 .env 并填写实际值后使用
# =============================================================================

# --- LLM (OpenAI-compatible) ---
# 支持 DeepSeek、OpenAI 及所有兼容 OpenAI API 的模型服务
LLM_API_KEY=sk-your-api-key-here              # API 密钥（必填）
LLM_BASE_URL=https://api.deepseek.com          # API 端点地址
LLM_MODEL=deepseek-chat                        # 默认模型名

# --- 小模型路由（可选）---
# 启用后，简单解释类任务会走小模型以节省成本
# LIGHT_LLM_ENDPOINT=https://api.example.com
# LIGHT_LLM_API_KEY=sk-your-light-key
# LIGHT_LLM_MODEL=deepseek-chat

# --- JWT 鉴权 ---
JWT_SECRET=eduagent-jwt-secret-change-in-production  # JWT 签名密钥（生产环境请修改）

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root123                    # root 密码
MYSQL_DATABASE=eduagent                        # 数据库名
MYSQL_USER=eduagent                            # 应用用户
MYSQL_PASSWORD=eduagent123                     # 应用用户密码

# --- Redis（语义缓存用）---
# 默认无需修改，容器内直连

# --- Qdrant（向量检索用）---
# 默认无需修改，容器内直连

# --- 应用配置 ---
ENVIRONMENT=development                        # development / production
LOG_LEVEL=DEBUG                                # DEBUG / INFO / WARNING / ERROR

# --- 前端 ---
VITE_API_BASE_URL=http://localhost:8000        # 后端 API 地址（前端访问用）
